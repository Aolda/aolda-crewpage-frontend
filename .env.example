# Public URL used by the browser. Keep this relative in every HTTPS deployment
# so API calls go through the same-origin Next.js rewrite.
NEXT_PUBLIC_BASE_URL=/api

# Server-only backend address. The default is http://localhost:8001 for local
# development. In k3s use the Kubernetes Service DNS, for example:
# BACKEND_INTERNAL_URL=http://ahp-backend.ahp.svc.cluster.local:8001
BACKEND_INTERNAL_URL=http://localhost:8001
